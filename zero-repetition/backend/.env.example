# Server-only environment variables. Never put values in site-config.js.
# The deployed project uses the private zero_repetition_runtime Vault JSON.
# These are alternative environment settings; configure the full set together.
ZR_SITE_ORIGIN=https://mofid-academy.github.io
ZR_SITE_URL=https://mofid-academy.github.io/zero-repetition/
ZR_ADMIN_USERNAME=m.mirsheri
ZR_ADMIN_KEY_HASH=
ZR_SIGNING_KEY=
# Both settings below are optional. An outage never prevents saving responses.
ZR_SHEETS_WEBHOOK=
ZR_SHEETS_SYNC_KEY=
